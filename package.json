{
  "name": "kiosco-avatar",
  "version": "0.1.0",
  "private": true,
  "description": "Avatar 3D parlante: NestJS + Three.js + Deepgram + DeepSeek + ElevenLabs",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
